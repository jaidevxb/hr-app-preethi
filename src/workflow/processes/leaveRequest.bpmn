<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                   xmlns:hr="https://leave-request-workflow.example/schema"
                   id="Definitions_LeaveRequest"
                   targetNamespace="https://leave-request-workflow.example/bpmn">

  <bpmn:process id="Process_LeaveRequest" name="Leave Request Approval" isExecutable="false">

    <bpmn:startEvent id="start" name="Request Submitted">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="employeeName" label="Employee name" type="string" hr:placeholder="e.g. Priya" />
          <camunda:formField id="days" label="Number of days" type="long" defaultValue="1" />
          <camunda:formField id="reason" label="Reason" type="string" hr:placeholder="e.g. Family trip" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_start_managerReview</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:userTask id="managerReview" name="Manager Review" camunda:assignee="Manager">
      <bpmn:incoming>flow_start_managerReview</bpmn:incoming>
      <bpmn:outgoing>flow_managerReview_gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="managerReviewTimer" name="3-day SLA" attachedToRef="managerReview" cancelActivity="true">
      <bpmn:outgoing>flow_timer_escalatedReview</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:userTask id="escalatedReview" name="Escalated Review (Skip-Level)" camunda:assignee="Skip-level Manager">
      <bpmn:incoming>flow_timer_escalatedReview</bpmn:incoming>
      <bpmn:outgoing>flow_escalatedReview_gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="approvalGateway" name="Approved?" default="flow_gateway_endRejected">
      <bpmn:incoming>flow_managerReview_gateway</bpmn:incoming>
      <bpmn:incoming>flow_escalatedReview_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_split</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_endRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- Once approved, the paperwork and the balance adjustment happen at the
         same time; the process only ends when both are done. -->
    <bpmn:parallelGateway id="splitApproved" name="Parallel Split">
      <bpmn:incoming>flow_gateway_split</bpmn:incoming>
      <bpmn:outgoing>flow_split_hrProcessing</bpmn:outgoing>
      <bpmn:outgoing>flow_split_updateBalance</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:userTask id="hrProcessing" name="HR Processes Leave" camunda:assignee="HR">
      <bpmn:incoming>flow_split_hrProcessing</bpmn:incoming>
      <bpmn:outgoing>flow_hrProcessing_join</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="updateBalance" name="Update Leave Balance" camunda:topic="leave.updateBalance">
      <bpmn:incoming>flow_split_updateBalance</bpmn:incoming>
      <bpmn:outgoing>flow_updateBalance_join</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:parallelGateway id="joinApproved" name="Parallel Join">
      <bpmn:incoming>flow_hrProcessing_join</bpmn:incoming>
      <bpmn:incoming>flow_updateBalance_join</bpmn:incoming>
      <bpmn:outgoing>flow_join_endApproved</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:endEvent id="endApproved" name="Leave Approved" hr:outcome="approved">
      <bpmn:incoming>flow_join_endApproved</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="endRejected" name="Leave Rejected" hr:outcome="rejected">
      <bpmn:incoming>flow_gateway_endRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_start_managerReview" sourceRef="start" targetRef="managerReview" />
    <bpmn:sequenceFlow id="flow_managerReview_gateway" sourceRef="managerReview" targetRef="approvalGateway" />
    <bpmn:sequenceFlow id="flow_timer_escalatedReview" sourceRef="managerReviewTimer" targetRef="escalatedReview" />
    <bpmn:sequenceFlow id="flow_escalatedReview_gateway" sourceRef="escalatedReview" targetRef="approvalGateway" />
    <bpmn:sequenceFlow id="flow_gateway_split" name="Approved" sourceRef="approvalGateway" targetRef="splitApproved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <!-- Default flow: per BPMN it carries no conditionExpression; the gateway's
         `default` attribute points here, so it is taken when nothing else matches. -->
    <bpmn:sequenceFlow id="flow_gateway_endRejected" name="Rejected" sourceRef="approvalGateway" targetRef="endRejected" />
    <bpmn:sequenceFlow id="flow_split_hrProcessing" sourceRef="splitApproved" targetRef="hrProcessing" />
    <bpmn:sequenceFlow id="flow_split_updateBalance" sourceRef="splitApproved" targetRef="updateBalance" />
    <bpmn:sequenceFlow id="flow_hrProcessing_join" sourceRef="hrProcessing" targetRef="joinApproved" />
    <bpmn:sequenceFlow id="flow_updateBalance_join" sourceRef="updateBalance" targetRef="joinApproved" />
    <bpmn:sequenceFlow id="flow_join_endApproved" sourceRef="joinApproved" targetRef="endApproved" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_LeaveRequest">

      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="140" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="115" y="284" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="managerReview_di" bpmnElement="managerReview">
        <dc:Bounds x="270" y="220" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="managerReviewTimer_di" bpmnElement="managerReviewTimer">
        <dc:Bounds x="312" y="282" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="345" y="381" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="escalatedReview_di" bpmnElement="escalatedReview">
        <dc:Bounds x="270" y="460" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="approvalGateway_di" bpmnElement="approvalGateway" isMarkerVisible="true">
        <dc:Bounds x="500" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="490" y="210" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="splitApproved_di" bpmnElement="splitApproved">
        <dc:Bounds x="620" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="hrProcessing_di" bpmnElement="hrProcessing">
        <dc:Bounds x="710" y="170" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="updateBalance_di" bpmnElement="updateBalance">
        <dc:Bounds x="710" y="290" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="joinApproved_di" bpmnElement="joinApproved">
        <dc:Bounds x="870" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endApproved_di" bpmnElement="endApproved">
        <dc:Bounds x="960" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="925" y="284" width="106" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endRejected_di" bpmnElement="endRejected">
        <dc:Bounds x="507" y="500" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="472" y="542" width="106" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="flow_start_managerReview_di" bpmnElement="flow_start_managerReview">
        <di:waypoint x="176" y="260" />
        <di:waypoint x="270" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_managerReview_gateway_di" bpmnElement="flow_managerReview_gateway">
        <di:waypoint x="390" y="260" />
        <di:waypoint x="500" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_timer_escalatedReview_di" bpmnElement="flow_timer_escalatedReview">
        <di:waypoint x="330" y="318" />
        <di:waypoint x="330" y="460" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_escalatedReview_gateway_di" bpmnElement="flow_escalatedReview_gateway">
        <di:waypoint x="390" y="500" />
        <di:waypoint x="500" y="500" />
        <di:waypoint x="500" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_gateway_split_di" bpmnElement="flow_gateway_split">
        <di:waypoint x="550" y="260" />
        <di:waypoint x="620" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="558" y="232" width="54" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_gateway_endRejected_di" bpmnElement="flow_gateway_endRejected">
        <di:waypoint x="525" y="285" />
        <di:waypoint x="525" y="500" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="537" y="384" width="52" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_split_hrProcessing_di" bpmnElement="flow_split_hrProcessing">
        <di:waypoint x="645" y="235" />
        <di:waypoint x="645" y="210" />
        <di:waypoint x="710" y="210" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_split_updateBalance_di" bpmnElement="flow_split_updateBalance">
        <di:waypoint x="645" y="285" />
        <di:waypoint x="645" y="330" />
        <di:waypoint x="710" y="330" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_hrProcessing_join_di" bpmnElement="flow_hrProcessing_join">
        <di:waypoint x="830" y="210" />
        <di:waypoint x="895" y="210" />
        <di:waypoint x="895" y="235" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_updateBalance_join_di" bpmnElement="flow_updateBalance_join">
        <di:waypoint x="830" y="330" />
        <di:waypoint x="895" y="330" />
        <di:waypoint x="895" y="285" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_join_endApproved_di" bpmnElement="flow_join_endApproved">
        <di:waypoint x="920" y="260" />
        <di:waypoint x="960" y="260" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
