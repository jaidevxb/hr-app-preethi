<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                   xmlns:hr="https://leave-request-workflow.example/schema"
                   id="Definitions_ExpenseApproval"
                   targetNamespace="https://leave-request-workflow.example/bpmn">

  <bpmn:process id="Process_ExpenseApproval" name="Expense Reimbursement" isExecutable="false">

    <bpmn:startEvent id="start" name="Expense Submitted">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="employeeName" label="Employee name" type="string" hr:placeholder="e.g. Ravi" />
          <camunda:formField id="amount" label="Amount (₹)" type="long" defaultValue="2500" />
          <camunda:formField id="category" label="Category" type="enum">
            <camunda:value id="travel" name="Travel" />
            <camunda:value id="meals" name="Meals" />
            <camunda:value id="equipment" name="Equipment" />
          </camunda:formField>
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_start_policyCheck</bpmn:outgoing>
    </bpmn:startEvent>

    <!-- A rule task decides whether a human needs to look at this at all. -->
    <bpmn:businessRuleTask id="policyCheck" name="Check Expense Policy" camunda:topic="expense.policyCheck">
      <bpmn:incoming>flow_start_policyCheck</bpmn:incoming>
      <bpmn:outgoing>flow_policyCheck_autoGateway</bpmn:outgoing>
    </bpmn:businessRuleTask>

    <bpmn:exclusiveGateway id="autoGateway" name="Auto-approve?" default="flow_auto_financeReview">
      <bpmn:incoming>flow_policyCheck_autoGateway</bpmn:incoming>
      <bpmn:outgoing>flow_auto_reimburse</bpmn:outgoing>
      <bpmn:outgoing>flow_auto_financeReview</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="financeReview" name="Finance Review" camunda:assignee="Finance Manager">
      <bpmn:incoming>flow_auto_financeReview</bpmn:incoming>
      <bpmn:outgoing>flow_financeReview_decision</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="decisionGateway" name="Approved?" default="flow_decision_endRejected">
      <bpmn:incoming>flow_financeReview_decision</bpmn:incoming>
      <bpmn:outgoing>flow_decision_reimburse</bpmn:outgoing>
      <bpmn:outgoing>flow_decision_endRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="reimburse" name="Reimburse to Payroll" camunda:topic="expense.reimburse">
      <bpmn:incoming>flow_auto_reimburse</bpmn:incoming>
      <bpmn:incoming>flow_decision_reimburse</bpmn:incoming>
      <bpmn:outgoing>flow_reimburse_endPaid</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="endPaid" name="Expense Reimbursed" hr:outcome="approved">
      <bpmn:incoming>flow_reimburse_endPaid</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="endRejected" name="Expense Rejected" hr:outcome="rejected">
      <bpmn:incoming>flow_decision_endRejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_start_policyCheck" sourceRef="start" targetRef="policyCheck" />
    <bpmn:sequenceFlow id="flow_policyCheck_autoGateway" sourceRef="policyCheck" targetRef="autoGateway" />
    <bpmn:sequenceFlow id="flow_auto_reimburse" name="Within policy" sourceRef="autoGateway" targetRef="reimburse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">autoApprove == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_auto_financeReview" name="Needs approval" sourceRef="autoGateway" targetRef="financeReview" />
    <bpmn:sequenceFlow id="flow_financeReview_decision" sourceRef="financeReview" targetRef="decisionGateway" />
    <bpmn:sequenceFlow id="flow_decision_reimburse" name="Approved" sourceRef="decisionGateway" targetRef="reimburse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_decision_endRejected" name="Rejected" sourceRef="decisionGateway" targetRef="endRejected" />
    <bpmn:sequenceFlow id="flow_reimburse_endPaid" sourceRef="reimburse" targetRef="endPaid" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_ExpenseApproval">

      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="140" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="115" y="284" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="policyCheck_di" bpmnElement="policyCheck">
        <dc:Bounds x="240" y="220" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="autoGateway_di" bpmnElement="autoGateway" isMarkerVisible="true">
        <dc:Bounds x="420" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="400" y="210" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="financeReview_di" bpmnElement="financeReview">
        <dc:Bounds x="530" y="380" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="decisionGateway_di" bpmnElement="decisionGateway" isMarkerVisible="true">
        <dc:Bounds x="700" y="395" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="685" y="370" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="reimburse_di" bpmnElement="reimburse">
        <dc:Bounds x="700" y="220" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endPaid_di" bpmnElement="endPaid">
        <dc:Bounds x="880" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="845" y="284" width="106" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endRejected_di" bpmnElement="endRejected">
        <dc:Bounds x="707" y="550" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="672" y="592" width="106" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="flow_start_policyCheck_di" bpmnElement="flow_start_policyCheck">
        <di:waypoint x="176" y="260" />
        <di:waypoint x="240" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_policyCheck_autoGateway_di" bpmnElement="flow_policyCheck_autoGateway">
        <di:waypoint x="360" y="260" />
        <di:waypoint x="420" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_auto_reimburse_di" bpmnElement="flow_auto_reimburse">
        <di:waypoint x="470" y="260" />
        <di:waypoint x="700" y="260" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="530" y="232" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_auto_financeReview_di" bpmnElement="flow_auto_financeReview">
        <di:waypoint x="445" y="285" />
        <di:waypoint x="445" y="420" />
        <di:waypoint x="530" y="420" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="452" y="330" width="100" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_financeReview_decision_di" bpmnElement="flow_financeReview_decision">
        <di:waypoint x="650" y="420" />
        <di:waypoint x="700" y="420" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_decision_reimburse_di" bpmnElement="flow_decision_reimburse">
        <di:waypoint x="725" y="395" />
        <di:waypoint x="725" y="340" />
        <di:waypoint x="760" y="340" />
        <di:waypoint x="760" y="300" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="640" y="352" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_decision_endRejected_di" bpmnElement="flow_decision_endRejected">
        <di:waypoint x="725" y="445" />
        <di:waypoint x="725" y="550" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="735" y="485" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_reimburse_endPaid_di" bpmnElement="flow_reimburse_endPaid">
        <di:waypoint x="820" y="260" />
        <di:waypoint x="880" y="260" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
