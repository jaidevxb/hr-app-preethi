<?xml version="1.0" encoding="UTF-8"?>
<!--
  A deliberately broken process, kept in the library so the validation panel
  has something real to catch. An exclusive gateway takes exactly one branch,
  but both branches feed a parallel join that waits for two — so whichever
  path runs, the join never fires and the instance hangs forever.

  Run it and watch: the task completes, the token parks at the join, and the
  process sits at 1/2 branches arrived with nothing left to do.
-->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                   xmlns:hr="https://leave-request-workflow.example/schema"
                   id="Definitions_DeadlockDemo"
                   targetNamespace="https://leave-request-workflow.example/bpmn">

  <bpmn:process id="Process_DeadlockDemo" name="Deadlock Demo (intentionally broken)" isExecutable="false">

    <bpmn:startEvent id="start" name="Request Started">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="requester" label="Requested by" type="string" hr:placeholder="e.g. Anya" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_start_gateway</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="pathGateway" name="Which path?" default="flow_gateway_rejectPath">
      <bpmn:incoming>flow_start_gateway</bpmn:incoming>
      <bpmn:outgoing>flow_gateway_approvePath</bpmn:outgoing>
      <bpmn:outgoing>flow_gateway_rejectPath</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="approvePath" name="Approve Path" camunda:assignee="Reviewer">
      <bpmn:incoming>flow_gateway_approvePath</bpmn:incoming>
      <bpmn:outgoing>flow_approvePath_join</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:userTask id="rejectPath" name="Reject Path" camunda:assignee="Reviewer">
      <bpmn:incoming>flow_gateway_rejectPath</bpmn:incoming>
      <bpmn:outgoing>flow_rejectPath_join</bpmn:outgoing>
    </bpmn:userTask>

    <!-- The bug: an AND-join downstream of an XOR-split. -->
    <bpmn:parallelGateway id="brokenJoin" name="Parallel Join">
      <bpmn:incoming>flow_approvePath_join</bpmn:incoming>
      <bpmn:incoming>flow_rejectPath_join</bpmn:incoming>
      <bpmn:outgoing>flow_join_end</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:endEvent id="endNever" name="Never Reached" hr:outcome="unreachable">
      <bpmn:incoming>flow_join_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_start_gateway" sourceRef="start" targetRef="pathGateway" />
    <bpmn:sequenceFlow id="flow_gateway_approvePath" name="Approve" sourceRef="pathGateway" targetRef="approvePath">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == "approved"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_gateway_rejectPath" name="Reject" sourceRef="pathGateway" targetRef="rejectPath" />
    <bpmn:sequenceFlow id="flow_approvePath_join" sourceRef="approvePath" targetRef="brokenJoin" />
    <bpmn:sequenceFlow id="flow_rejectPath_join" sourceRef="rejectPath" targetRef="brokenJoin" />
    <bpmn:sequenceFlow id="flow_join_end" sourceRef="brokenJoin" targetRef="endNever" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_DeadlockDemo">

      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="140" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="115" y="284" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="pathGateway_di" bpmnElement="pathGateway" isMarkerVisible="true">
        <dc:Bounds x="240" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="225" y="210" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="approvePath_di" bpmnElement="approvePath">
        <dc:Bounds x="350" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="rejectPath_di" bpmnElement="rejectPath">
        <dc:Bounds x="350" y="300" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="brokenJoin_di" bpmnElement="brokenJoin">
        <dc:Bounds x="550" y="235" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endNever_di" bpmnElement="endNever">
        <dc:Bounds x="660" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="625" y="284" width="106" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="flow_start_gateway_di" bpmnElement="flow_start_gateway">
        <di:waypoint x="176" y="260" />
        <di:waypoint x="240" y="260" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_gateway_approvePath_di" bpmnElement="flow_gateway_approvePath">
        <di:waypoint x="265" y="235" />
        <di:waypoint x="265" y="200" />
        <di:waypoint x="350" y="200" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="272" y="172" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_gateway_rejectPath_di" bpmnElement="flow_gateway_rejectPath">
        <di:waypoint x="265" y="285" />
        <di:waypoint x="265" y="340" />
        <di:waypoint x="350" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="272" y="348" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_approvePath_join_di" bpmnElement="flow_approvePath_join">
        <di:waypoint x="470" y="200" />
        <di:waypoint x="575" y="200" />
        <di:waypoint x="575" y="235" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_rejectPath_join_di" bpmnElement="flow_rejectPath_join">
        <di:waypoint x="470" y="340" />
        <di:waypoint x="575" y="340" />
        <di:waypoint x="575" y="285" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_join_end_di" bpmnElement="flow_join_end">
        <di:waypoint x="600" y="260" />
        <di:waypoint x="660" y="260" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
