<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                   xmlns:hr="https://leave-request-workflow.example/schema"
                   id="Definitions_VendorPurchaseOrder"
                   targetNamespace="https://leave-request-workflow.example/bpmn">

  <bpmn:message id="VendorConfirmed" name="Vendor confirmed the order" />
  <bpmn:signal id="BudgetPulled" name="Budget freeze announced" />

  <bpmn:process id="Process_VendorPurchaseOrder" name="Vendor Purchase Order" isExecutable="false">

    <bpmn:startEvent id="start" name="PO Raised">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="vendor" label="Vendor" type="string" hr:placeholder="e.g. Nandi Supplies" />
          <camunda:formField id="amount" label="Order value (₹)" type="long" defaultValue="40000" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_start_sendPO</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="sendPO" name="Send PO to Vendor" camunda:topic="po.send">
      <bpmn:incoming>flow_start_sendPO</bpmn:incoming>
      <bpmn:outgoing>flow_sendPO_split</bpmn:outgoing>
    </bpmn:serviceTask>

    <!--
      Three things can happen next and only one of them will: the vendor
      confirms, the deadline passes, or Finance pulls the budget. Each branch
      ends in a *terminate* end event, so whichever gets there first discards
      the other two tokens where they stand.
    -->
    <bpmn:parallelGateway id="raceSplit" name="Parallel Split">
      <bpmn:incoming>flow_sendPO_split</bpmn:incoming>
      <bpmn:outgoing>flow_split_confirm</bpmn:outgoing>
      <bpmn:outgoing>flow_split_timeout</bpmn:outgoing>
      <bpmn:outgoing>flow_split_budget</bpmn:outgoing>
    </bpmn:parallelGateway>

    <bpmn:intermediateCatchEvent id="catchConfirm" name="Vendor Confirms">
      <bpmn:incoming>flow_split_confirm</bpmn:incoming>
      <bpmn:outgoing>flow_confirm_receive</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="VendorConfirmed" />
    </bpmn:intermediateCatchEvent>

    <bpmn:userTask id="receiveGoods" name="Receive Goods" camunda:assignee="Warehouse">
      <bpmn:incoming>flow_confirm_receive</bpmn:incoming>
      <bpmn:outgoing>flow_receive_end</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:intermediateCatchEvent id="catchTimeout" name="No reply in 5 days">
      <bpmn:incoming>flow_split_timeout</bpmn:incoming>
      <bpmn:outgoing>flow_timeout_end</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>

    <bpmn:intermediateCatchEvent id="catchBudget" name="Budget Pulled">
      <bpmn:incoming>flow_split_budget</bpmn:incoming>
      <bpmn:outgoing>flow_budget_end</bpmn:outgoing>
      <bpmn:signalEventDefinition id="SignalEventDefinition_1" signalRef="BudgetPulled" />
    </bpmn:intermediateCatchEvent>

    <bpmn:endEvent id="endFulfilled" name="PO Fulfilled" hr:outcome="fulfilled">
      <bpmn:incoming>flow_receive_end</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_1" />
    </bpmn:endEvent>

    <bpmn:endEvent id="endCancelled" name="PO Cancelled" hr:outcome="cancelled">
      <bpmn:incoming>flow_timeout_end</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_2" />
    </bpmn:endEvent>

    <bpmn:endEvent id="endBudget" name="Cancelled by Finance" hr:outcome="cancelled">
      <bpmn:incoming>flow_budget_end</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_3" />
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_start_sendPO" sourceRef="start" targetRef="sendPO" />
    <bpmn:sequenceFlow id="flow_sendPO_split" sourceRef="sendPO" targetRef="raceSplit" />
    <bpmn:sequenceFlow id="flow_split_confirm" sourceRef="raceSplit" targetRef="catchConfirm" />
    <bpmn:sequenceFlow id="flow_split_timeout" sourceRef="raceSplit" targetRef="catchTimeout" />
    <bpmn:sequenceFlow id="flow_split_budget" sourceRef="raceSplit" targetRef="catchBudget" />
    <bpmn:sequenceFlow id="flow_confirm_receive" sourceRef="catchConfirm" targetRef="receiveGoods" />
    <bpmn:sequenceFlow id="flow_receive_end" sourceRef="receiveGoods" targetRef="endFulfilled" />
    <bpmn:sequenceFlow id="flow_timeout_end" sourceRef="catchTimeout" targetRef="endCancelled" />
    <bpmn:sequenceFlow id="flow_budget_end" sourceRef="catchBudget" targetRef="endBudget" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_VendorPurchaseOrder">

      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="140" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="115" y="364" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="sendPO_di" bpmnElement="sendPO">
        <dc:Bounds x="240" y="300" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="raceSplit_di" bpmnElement="raceSplit">
        <dc:Bounds x="420" y="315" width="50" height="50" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="catchConfirm_di" bpmnElement="catchConfirm">
        <dc:Bounds x="520" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="485" y="224" width="106" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="receiveGoods_di" bpmnElement="receiveGoods">
        <dc:Bounds x="640" y="160" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endFulfilled_di" bpmnElement="endFulfilled">
        <dc:Bounds x="820" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="785" y="224" width="106" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="catchTimeout_di" bpmnElement="catchTimeout">
        <dc:Bounds x="520" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="483" y="364" width="110" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endCancelled_di" bpmnElement="endCancelled">
        <dc:Bounds x="700" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="665" y="364" width="106" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="catchBudget_di" bpmnElement="catchBudget">
        <dc:Bounds x="520" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="485" y="494" width="106" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endBudget_di" bpmnElement="endBudget">
        <dc:Bounds x="700" y="452" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="660" y="494" width="116" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="flow_start_sendPO_di" bpmnElement="flow_start_sendPO">
        <di:waypoint x="176" y="340" />
        <di:waypoint x="240" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_sendPO_split_di" bpmnElement="flow_sendPO_split">
        <di:waypoint x="360" y="340" />
        <di:waypoint x="420" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_split_confirm_di" bpmnElement="flow_split_confirm">
        <di:waypoint x="445" y="315" />
        <di:waypoint x="445" y="200" />
        <di:waypoint x="520" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_split_timeout_di" bpmnElement="flow_split_timeout">
        <di:waypoint x="470" y="340" />
        <di:waypoint x="520" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_split_budget_di" bpmnElement="flow_split_budget">
        <di:waypoint x="445" y="365" />
        <di:waypoint x="445" y="470" />
        <di:waypoint x="520" y="470" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_confirm_receive_di" bpmnElement="flow_confirm_receive">
        <di:waypoint x="556" y="200" />
        <di:waypoint x="640" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_receive_end_di" bpmnElement="flow_receive_end">
        <di:waypoint x="760" y="200" />
        <di:waypoint x="820" y="200" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_timeout_end_di" bpmnElement="flow_timeout_end">
        <di:waypoint x="556" y="340" />
        <di:waypoint x="700" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_budget_end_di" bpmnElement="flow_budget_end">
        <di:waypoint x="556" y="470" />
        <di:waypoint x="700" y="470" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
