<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                   xmlns:hr="https://leave-request-workflow.example/schema"
                   id="Definitions_EmployeeOffboarding"
                   targetNamespace="https://leave-request-workflow.example/bpmn">

  <bpmn:process id="Process_EmployeeOffboarding" name="Employee Offboarding" isExecutable="false">

    <bpmn:startEvent id="start" name="Exit Announced">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="employeeName" label="Leaver" type="string" hr:placeholder="e.g. Dev" />
          <camunda:formField id="hasLaptop" label="Has a company laptop?" type="boolean" defaultValue="true" />
          <camunda:formField id="hasParkingPass" label="Has a parking pass?" type="boolean" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:outgoing>flow_start_split</bpmn:outgoing>
    </bpmn:startEvent>

    <!--
      An inclusive (OR) gateway: revoking access always happens, the other two
      tracks only if the form says they apply. So one, two or three branches
      run — and the join has to cope with not knowing which in advance.
    -->
    <bpmn:inclusiveGateway id="splitExit" name="Which apply?">
      <bpmn:incoming>flow_start_split</bpmn:incoming>
      <bpmn:outgoing>flow_split_revokeAccess</bpmn:outgoing>
      <bpmn:outgoing>flow_split_collectLaptop</bpmn:outgoing>
      <bpmn:outgoing>flow_split_revokeParking</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:serviceTask id="revokeAccess" name="Revoke Access" camunda:topic="offboarding.revokeAccess">
      <bpmn:incoming>flow_split_revokeAccess</bpmn:incoming>
      <bpmn:outgoing>flow_revokeAccess_join</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="collectLaptop" name="Collect Laptop" camunda:assignee="IT">
      <bpmn:incoming>flow_split_collectLaptop</bpmn:incoming>
      <bpmn:outgoing>flow_collectLaptop_join</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="revokeParking" name="Revoke Parking Pass" camunda:topic="offboarding.revokeParking">
      <bpmn:incoming>flow_split_revokeParking</bpmn:incoming>
      <bpmn:outgoing>flow_revokeParking_join</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:inclusiveGateway id="joinExit" name="Join what ran">
      <bpmn:incoming>flow_revokeAccess_join</bpmn:incoming>
      <bpmn:incoming>flow_collectLaptop_join</bpmn:incoming>
      <bpmn:incoming>flow_revokeParking_join</bpmn:incoming>
      <bpmn:outgoing>flow_join_exitInterview</bpmn:outgoing>
    </bpmn:inclusiveGateway>

    <bpmn:userTask id="exitInterview" name="Exit Interview" camunda:assignee="HR">
      <bpmn:incoming>flow_join_exitInterview</bpmn:incoming>
      <bpmn:outgoing>flow_exitInterview_end</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="endOffboarded" name="Offboarded" hr:outcome="offboarded">
      <bpmn:incoming>flow_exitInterview_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="flow_start_split" sourceRef="start" targetRef="splitExit" />
    <!-- No conditionExpression: an inclusive gateway always takes this one. -->
    <bpmn:sequenceFlow id="flow_split_revokeAccess" name="Always" sourceRef="splitExit" targetRef="revokeAccess" />
    <bpmn:sequenceFlow id="flow_split_collectLaptop" name="Has laptop" sourceRef="splitExit" targetRef="collectLaptop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasLaptop == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_split_revokeParking" name="Has parking pass" sourceRef="splitExit" targetRef="revokeParking">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">hasParkingPass == true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_revokeAccess_join" sourceRef="revokeAccess" targetRef="joinExit" />
    <bpmn:sequenceFlow id="flow_collectLaptop_join" sourceRef="collectLaptop" targetRef="joinExit" />
    <bpmn:sequenceFlow id="flow_revokeParking_join" sourceRef="revokeParking" targetRef="joinExit" />
    <bpmn:sequenceFlow id="flow_join_exitInterview" sourceRef="joinExit" targetRef="exitInterview" />
    <bpmn:sequenceFlow id="flow_exitInterview_end" sourceRef="exitInterview" targetRef="endOffboarded" />

  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_EmployeeOffboarding">

      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="140" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="115" y="364" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="splitExit_di" bpmnElement="splitExit">
        <dc:Bounds x="240" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="205" y="280" width="120" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="revokeAccess_di" bpmnElement="revokeAccess">
        <dc:Bounds x="350" y="180" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="collectLaptop_di" bpmnElement="collectLaptop">
        <dc:Bounds x="350" y="300" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="revokeParking_di" bpmnElement="revokeParking">
        <dc:Bounds x="350" y="420" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="joinExit_di" bpmnElement="joinExit">
        <dc:Bounds x="530" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="495" y="280" width="120" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="exitInterview_di" bpmnElement="exitInterview">
        <dc:Bounds x="630" y="300" width="120" height="80" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="endOffboarded_di" bpmnElement="endOffboarded">
        <dc:Bounds x="820" y="322" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="785" y="364" width="106" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="flow_start_split_di" bpmnElement="flow_start_split">
        <di:waypoint x="176" y="340" />
        <di:waypoint x="240" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_split_revokeAccess_di" bpmnElement="flow_split_revokeAccess">
        <di:waypoint x="265" y="315" />
        <di:waypoint x="265" y="220" />
        <di:waypoint x="350" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="272" y="250" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_split_collectLaptop_di" bpmnElement="flow_split_collectLaptop">
        <di:waypoint x="290" y="340" />
        <di:waypoint x="350" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="285" y="310" width="64" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_split_revokeParking_di" bpmnElement="flow_split_revokeParking">
        <di:waypoint x="265" y="365" />
        <di:waypoint x="265" y="460" />
        <di:waypoint x="350" y="460" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="272" y="400" width="110" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_revokeAccess_join_di" bpmnElement="flow_revokeAccess_join">
        <di:waypoint x="470" y="220" />
        <di:waypoint x="555" y="220" />
        <di:waypoint x="555" y="315" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_collectLaptop_join_di" bpmnElement="flow_collectLaptop_join">
        <di:waypoint x="470" y="340" />
        <di:waypoint x="530" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_revokeParking_join_di" bpmnElement="flow_revokeParking_join">
        <di:waypoint x="470" y="460" />
        <di:waypoint x="555" y="460" />
        <di:waypoint x="555" y="365" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_join_exitInterview_di" bpmnElement="flow_join_exitInterview">
        <di:waypoint x="580" y="340" />
        <di:waypoint x="630" y="340" />
      </bpmndi:BPMNEdge>

      <bpmndi:BPMNEdge id="flow_exitInterview_end_di" bpmnElement="flow_exitInterview_end">
        <di:waypoint x="750" y="340" />
        <di:waypoint x="820" y="340" />
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
